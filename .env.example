# =============================================================================
# 有机化学知识智能体 — 环境变量模板
# 用法：cp .env.example .env 后填入密钥（.env 不会被提交，见 .gitignore）
#
# 本文件的定位：**服务器侧默认值**。有两个调用方没有自己的设置面板，
# 只能读这里：① 清小搭接入（/v1/*） ② Streamlit 本地界面。
# 公开网页（/chat）的用户在页面里填的参数会**覆盖**这里的对应项。
#
# 参数体系：网页面板 / 请求头 / 本文件三者**同名同义**。
# =============================================================================

# ── A. 模型参数（网页用户也能填，这里填的是服务器默认值）──────────────────
# A1. 主模型：**整个服务只用一个模型**。
API_KEY=your-api-key-here
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash

# A2. 思考参数（两个正交开关，与网页面板的「思考」+「思考强度」一致）
# THINKING_DEFAULT：思考开关。on = 开启思考（此时 EFFORT_DEFAULT 生效）；
#   off = 关闭思考（最省钱；若端点强制思考，会自动退回该端点允许的最低档，
#         并在回答末尾提示一次"该模型始终思考，无法关闭"）。
# 注意：不同端点对"关闭"与"强度取值"的支持不同（例如 GLM 无法关闭、
# Gemini 不接受 medium），服务端会**自动探测并适配**，无需在此特殊配置。
THINKING_DEFAULT=on
# 思考强度：low / medium / high / max（仅 THINKING_DEFAULT=on 时生效）
EFFORT_DEFAULT=low

# A3. 最大输出上限（tokens）
# 这是"上限"不是"预留"，按实际用量计费，调大不会多扣费；
# 设得太小会导致生成被截断（思考型模型尤其容易：思考与回答共享这个额度）。
# 建议保持 32768；调小可限制极端情况下的浪费，调大无收益（模型有自身上限）。
MAX_TOKENS=32768

# ── B. 视觉模型（可选：仅当主模型不支持图片识别时才需要）──────────────────
# 原生多模态模型（如 deepseek-flash、Gemini、GLM 视觉版）**自带视觉**，
# 此时整组留空即可——系统会直接用主模型识图。
# 只有当 MODEL_NAME 指向纯文本模型（Kimi、部分开源模型等）时才需要填写。
#
# 未单独填写 VISION_BASE_URL / VISION_API_KEY 时，沿用主模型的端点与密钥
# （多数 OpenAI 兼容端点同一把 Key 即可访问视觉模型）。
# VISION_MODEL=glm-5.3-flash
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=your-vision-key
# 视觉的思考参数（留空 = 与主模型相同时复用主模型设置，否则默认关闭思考）：
# VISION_THINKING=on
# VISION_EFFORT=low

# ── C. 清小搭接入（运维参数，不进网页面板）────────────────────────────────
# 服务端 Bearer 密钥：自己定一个强随机串，接入向导的「API 密钥」填同一个值
# SERVICE_API_KEY=sk-your-service-key
# 服务公网地址：**只给 /v1（清小搭）用**，拼接附件下载 URL（清小搭在服务端
# 抓图，必须是绝对地址）。不填则按请求 Host 推导，Nginx 反代需
# proxy_set_header Host $host;
# 公开网页 /chat 的图示 URL 是**同源相对路径**，与这里无关——别指望它去修网页裂图
# PUBLIC_BASE_URL=https://your.host
# 同一把 Key 的并发调用上限（防止打爆上游限流）
# MAX_CONCURRENT_LLM=4

# ── D. 公开网页（运维参数，不进网页面板）──────────────────────────────────
# 仅本地自测本机模型服务时开启；**公网禁止**（服务端会带用户密钥请求该地址，
# 放任内网等于把服务器当 SSRF 跳板）
# WEB_ALLOW_PRIVATE_BASE_URL=1

# ── E. 其它（可选）────────────────────────────────────────────────────────
# 临时工作目录（LaTeX 编译中间文件、/v1 请求级目录；见 DEPLOY.md §2.2）。
# 不填 = 用系统临时目录。只读 /tmp 的容器里指向一个可写目录（别用内存盘）：
# CHEM_AGENT_TMPDIR=
