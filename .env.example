# 有机化学知识智能体 - 环境变量模板
# 用法：复制为 .env，填入密钥。cp .env.example .env
# 配置统一入口：core/config.py

# LLM 服务（兼容 OpenAI 接口：DeepSeek / SiliconFlow / 智谱等）
API_KEY=your-api-key-here
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash

# 思考模式开关（DeepSeek 官方参数 thinking.type）：
# enabled（默认，先输出思维链再回答，准确性高但慢且 token 消耗大）
# disabled（关闭思考，快且省 token；temperature 等参数才生效）
# 留空则不传该参数（用 API 默认）。复杂问题在思考模式下可能思考过长导致无正式回答，
# 建议配合 REASONING_EFFORT=low 使用，或设为 disabled。
THINKING_MODE=disabled

# 思考强度（DeepSeek 官方参数 reasoning_effort，仅思考模式开启时生效）：
# low / high / max，留空则不传（API 默认 high）。
# 实际映射：deepseek-v4-flash → low/high/max；deepseek-v4-pro → high/xhigh/max。
# 渲染标记生成任务建议 low：思考短、响应快、省 token，避免长思考吃光预算后无正式回答。
# REASONING_EFFORT=low

# 回退模型（可选）：主模型思考开启且复杂问题思考过长时
# 只输出 reasoning 而无正式回答（content 为空）→ 先在同模型上渐进降级
# 思考强度（配置强度 → low → 关思考）重试，仍失败再切换到此模型；
# 回退调用强制 thinking=disabled，保证给出正式回答。
# 建议填轻量模型（如 deepseek-v4-flash）。注意 DeepSeek 现仅 v4-flash / v4-pro
# 两个版本，旧名 deepseek-chat / deepseek-reasoner 已下线。留空则不回退。
# FALLBACK_MODEL_NAME=deepseek-v4-flash

# 并发 LLM 调用上限（默认 4）：信号量限制同时进行的调用数，超出的排队等待，
# 避免多用户并发打爆 LLM API 限流。部署在清小搭等公网服务时建议 2~4。
# MAX_CONCURRENT_LLM=4

# 备选：SiliconFlow
# BASE_URL=https://api.siliconflow.cn/v1
# MODEL_NAME=deepseek-ai/DeepSeek-V3

# 视觉模型（图片识别结构式用；接入清小搭并开放图片输入时必填——
# 主模型 DeepSeek 为纯文本，无法识别图片）
# 智谱 GLM-4.6V（需智谱 API key，与上方 DeepSeek 独立）
# VISION_MODEL=glm-4.6v
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=你的智谱API-key

# 可选：EPA CompTox 实验性质查询（legacy/comptox_helper.py）
# 免费 key 需邮件 ccte_api@epa.gov 申请
# COMPTOX_API_KEY=your-comptox-api-key

# 清小搭接入服务（api.py）的服务端密钥：自己定一个强随机串，
# 接入向导中「API 密钥」填同一个值
# SERVICE_API_KEY=sk-your-service-key

# 服务公网地址（用于拼接图片附件下载 URL，x_soda.attachments 的 fileUrl）。
# 不填则按请求 Host 推导（Nginx 反代需 proxy_set_header Host $host;）
# PUBLIC_BASE_URL=https://your.host
